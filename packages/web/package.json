{
  "name": "@termysh/web",
  "version": "0.1.0",
  "description": "Termy terminal for the browser: canvas renderer, input, selection, links, themes and kitty graphics on the Termy wasm engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termylabs/termy.git",
    "directory": "packages/web"
  },
  "keywords": [
    "terminal",
    "wasm",
    "xterm",
    "xterm.js",
    "kitty"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@termysh/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
